MQTT_URL=mqtt://localhost:1883
GATEWAY_CLIENT_ID=ble-gateway-01

# The Core serves HTTPS only (self-signed dev cert). CORE_CA_CERT points at
# that cert so the agent can verify it; generated on the Core's first start.
CORE_URL=https://localhost:7000
CORE_CA_CERT=../core-server-poc/certs/dev-cert.pem
# Same value as the Core's DEV_BEARER_TOKEN.
CORE_BEARER_TOKEN=change-me

# Local-only HTTP endpoint an operator posts the scanned QR JSON to — this
# agent has no camera. See src/qrInput.js.
QR_INPUT_PORT=4001

# This agent has no UI, so a bench test device's Wi-Fi credentials come from
# here rather than being typed into an app.
TEST_WIFI_SSID=
TEST_WIFI_PASSWORD=

# MQTT login (username is GATEWAY_CLIENT_ID); same value as GATEWAY_MQTT_PASSWORD
# in the Core's .env.
GATEWAY_MQTT_PASSWORD=change-me
