MQTT_URL=mqtt://localhost:1883
GATEWAY_CLIENT_ID=ble-gateway-01

CORE_URL=http://localhost:7000
CORE_BEARER_TOKEN=poc-dev-token

# Local-only HTTP endpoint an operator posts the scanned QR JSON to — this
# agent has no camera. See src/qrInput.js.
QR_INPUT_PORT=4001

# This agent has no UI, so a bench test device's Wi-Fi credentials come from
# here rather than being typed into an app.
TEST_WIFI_SSID=
TEST_WIFI_PASSWORD=
