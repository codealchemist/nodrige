PORT=7000
DEV_BEARER_TOKEN=poc-dev-token
MQTT_URL=mqtt://localhost:1883
GATEWAY_CLIENT_ID=ble-gateway-01

# Integration settings below can also be entered from the console (Settings),
# which saves them in data/integrations.json and takes precedence over .env.

# Tuya cloud (panel scenes: Night / Day). Cloud project at iot.tuya.com with
# your Smart Life account linked; see src/extensions/menu-tasks/tuya.js.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_BASE_URL=https://openapi.tuyaus.com
# Optional: TUYA_UID=  or  TUYA_HOME_ID=

# Weather (panel Weather page + SMN alerts). By default the location is the
# home set in the Smart Life app (Tuya). To use another place, give an
# address: it's looked up once with OpenStreetMap Nominatim and cached in
# data/weather-location.json. Coordinates are rounded to ~1 km before use.
# WEATHER_ADDRESS=

# Web console (nodrige/web-console). Read-only MQTT login the browser uses
# through the Core's /mqtt WebSocket bridge (the dev broker enforces it).
# CONSOLE_MQTT_PASSWORD=console-dev
# Where the panel firmware repo is (icons, default menu) for the builder.
# FIRMWARE_DIR=../../esp32-c6-control/poc

# Spotify (panel Like and Skip & drop buttons). Create an app at
# https://developer.spotify.com/dashboard, add the redirect URI below to it,
# then connect your account from the console's Settings page. PKCE: no
# client secret needed. The token is kept in data/spotify-token.json.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=https://127.0.0.1:7000/spotify/callback
