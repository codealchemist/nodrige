{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nodrige.local/schemas/panel-config.json",
  "title": "Panel config",
  "description": "The ESP32-C6 panel's menu config (esp32-c6-control docs/ARCHITECTURE.md §5). Mirrors the firmware's validator (poc/src/config_store.cpp), which stays the final word; keep the two in step. configVersion is optional here because the Core assigns it on send.",
  "type": "object",
  "required": ["menu"],
  "properties": {
    "configVersion": { "type": "integer", "minimum": 1 },
    "mqtt": {
      "type": "object",
      "not": { "required": ["password"] },
      "description": "Filled from provisioning on the device; never send a password."
    },
    "menu": { "$ref": "#/definitions/nodes" }
  },
  "definitions": {
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["task", "switch", "folder", "action", "player"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "icon": { "type": "string" },
        "shortcut": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "task" } } },
          "then": {
            "required": ["task"],
            "properties": {
              "task": { "$ref": "#/definitions/task" },
              "shortcut": {
                "oneOf": [
                  { "type": "boolean" },
                  { "type": "object", "properties": { "off": { "type": "object" } }, "additionalProperties": false }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "switch" } } },
          "then": {
            "required": ["switch"],
            "properties": {
              "switch": {
                "type": "object",
                "required": ["payload"],
                "properties": {
                  "payload": { "type": "object" },
                  "on": { "type": "object" },
                  "off": { "type": "object" },
                  "state": {
                    "type": "object",
                    "required": ["taskId"],
                    "description": "How the panel reads the real state: a task (payload) whose reply carries state on/off. Read on boot, on screen wake and when its page opens. Without it, switches with a tuyaScene 'on' are read from that scene's lights."
                  },
                  "qos": { "enum": [0, 1, 2] },
                  "expectsResult": { "type": "boolean" },
                  "default": { "type": "boolean" }
                }
              },
              "shortcut": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "folder" } } },
          "then": {
            "properties": {
              "children": { "$ref": "#/definitions/nodes" },
              "binding": { "enum": ["message_inbox"] },
              "shortcut": false
            },
            "anyOf": [{ "required": ["children"] }, { "required": ["binding"] }]
          }
        },
        {
          "if": { "properties": { "type": { "const": "action" } } },
          "then": {
            "required": ["action"],
            "properties": {
              "action": {
                "enum": [
                  "reprovision", "restoreDefaultConfig", "showAbout", "volume", "phoneVolume",
                  "screenDim", "screenOff", "switchSync", "shortcut", "weather"
                ]
              },
              "shortcut": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "player" } } },
          "then": {
            "required": ["player"],
            "properties": {
              "player": {
                "type": "object",
                "required": ["taskId"],
                "properties": {
                  "taskId": { "type": "string", "minLength": 1 },
                  "qos": { "enum": [0, 1, 2] }
                },
                "additionalProperties": false
              },
              "shortcut": false
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "payload": { "type": "object" },
        "qos": { "enum": [0, 1, 2] },
        "expectsResult": { "type": "boolean" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "type"],
            "properties": {
              "key": { "type": "string" },
              "type": { "enum": ["int", "enum", "bool", "date", "time", "string"] }
            }
          }
        }
      }
    }
  }
}
